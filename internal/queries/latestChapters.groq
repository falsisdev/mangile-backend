*[(_type == "mangaChapter" || _type == "novelChapter")] | order(_createdAt desc) {
  _createdAt,
  _id,
  _type,
  _updatedAt,
  chapterNumber,
  volumeNumber,
  title,
  defined(lightNovel)=>{
    lightNovel->{
      title,
      myAnimeListId,
      _id,
      coverImage{
        "url": asset->url
      }
    }
  },
  defined(manga)=>{
    manga->{
      title,
      myAnimeListId,
      _id,
      coverImage{
        "url": asset->url
      }
    }
  },
  source->{
    name,
    website
  }
}[0...20]